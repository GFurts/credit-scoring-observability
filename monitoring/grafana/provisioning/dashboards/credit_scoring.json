    {
      "id": 13,
      "title": "Alertas por regra",
      "description": "Total de alertas disparados desde o início",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 23,
